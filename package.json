{
  "name": "js-applicability",
  "private": true,
  "type": "module",
  "scripts": {
    "stage:prep": "node scripts/prep.ts",
    "stage:equiv": "node scripts/equiv.ts",
    "stage:prune": "node scripts/prune.ts",
    "stage:cond": "node scripts/cond.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "tsc --noEmit && oxlint --type-aware && oxfmt --check src scripts test *.json",
    "fmt": "oxfmt src scripts test *.json"
  },
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.1.2",
    "oxfmt": "0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
